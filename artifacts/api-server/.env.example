# CardWatch API Server — environment variables
# Copy this file to .env and fill in your values before running the server.

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, Railway, local, etc.)
DATABASE_URL=postgresql://user:password@host:5432/cardwatch

# Port the Express server listens on
PORT=5000

# ── Card identification + pricing (PkmnPrices API) ───────────────────────────
# Used by both the card-provider (identify) and price-provider (market prices).
# Get a key at https://pkmnprices.com
CARD_API_KEY=pk_d2224bcfe5ff4746f952383806cd30342965af2f438bbbe9

# Alias — the server checks CARD_API_KEY first, then PRICE_API_KEY.
# Set both to the same value, or just set CARD_API_KEY.
PRICE_API_KEY=pk_d2224bcfe5ff4746f952383806cd30342965af2f438bbbe9

# ── Discord notifications (optional) ────────────────────────────────────────
# Create a webhook in your Discord server under Server Settings → Integrations.
# Leave blank to disable Discord alerts entirely.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
